#python:
import math

center_x = 0.3
center_y = 0.3
z_length = 0.002

layers = [
    (0.120, 'bark'),
    (0.115, 'cambium'),
    (0.105, 'outer_sapwood'),
    (0.080, 'inner_sapwood'),
    (0.060, 'rings'),
    (0.030, 'heartwood')
]

for r, mat in layers:
    print(f"#cylinder: {center_x} {center_y} 0.0 {center_x} {center_y} {z_length} {r} {mat}")

profondeur_trou = 0.0508
rayon_trou = 0.004
x_debut = center_x + layers[0][0] - profondeur_trou
x_fin = center_x + layers[0][0]

print(f"#box: {x_debut} {center_y - rayon_trou} 0.0 {x_fin} {center_y + rayon_trou} {z_length} air")

n_scans = 60
angle_start = -math.pi / 4
angle_end = math.pi / 4

curr_a = angle_start + (current_model_run - 1) * (angle_end - angle_start) / max(1, n_scans - 1)

r_ant = layers[0][0] + 0.015
ax = center_x + r_ant * math.cos(curr_a)
ay = center_y + r_ant * math.sin(curr_a)
az = 0.001

print(f"#hertzian_dipole: z {ax:.4f} {ay:.4f} {az:.4f} my_pulse")
print(f"#rx: {ax:.4f} {ay:.4f} {az:.4f}")
#end_python:

